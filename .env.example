# Copy this file to .env and adjust values before running `docker compose up`.
# .env is git-ignored — never commit real secrets.

# ---- Local PostgreSQL fallback (optional) ----
# The normal development path uses Neon through DATABASE_URL below. These values
# are only used when running `docker compose --profile local-db up`.
POSTGRES_USER=vulnvista
POSTGRES_PASSWORD=change-me-in-dev
POSTGRES_DB=vulnvista
POSTGRES_PORT=5432
# Host path where PostgreSQL data is persisted (bind mount, survives `docker compose down`)
POSTGRES_DATA_DIR=./storage/postgres

# ---- Backend (FastAPI) ----
BACKEND_PORT=9000
BACKEND_CORS_ORIGINS=http://localhost:5173
# Host path where scan evidence / uploaded files are persisted
BACKEND_STORAGE_DIR=./storage/uploads
SECRET_KEY=change-me-generate-a-random-64-char-value
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Consecutive failed logins before an account locks, and for how long. 0 disables lockout.
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
# How long a password-reset token stays redeemable.
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
# Created once on startup when no matching account exists. Use a unique, strong password:
# at least 12 characters combining three of lowercase, uppercase, digits, and symbols —
# the same policy every password set through the API has to meet.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_EMAIL=admin@example.test
INITIAL_ADMIN_PASSWORD=Change-This-Before-Start-1
ENVIRONMENT=development
LOG_LEVEL=INFO
# Default-deny scan allowlist: only targets whose host is listed here are
# approved for active scanning. Hosts are as the backend container sees them
# on vulnvista_net (service names), not the browser's localhost ports.
LAB_ALLOWED_HOSTS=dvwa,juice-shop,vulnvista_dvwa,vulnvista_juice_shop,metasploitable2,vulnvista_metasploitable2,tls-test,vulnvista_tls_test,localhost,127.0.0.1

# Neon pooled connection string used by the backend container.
# Replace USER, PASSWORD, REGION, and DBNAME with your Neon project values.
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DBNAME?ssl=require
# Set to 0 if Alembic migrations are applied out of band.
RUN_MIGRATIONS=1

# ---- Hosted Postgres (Neon / Supabase) — optional ----
# To use a managed database instead of the local `postgres` container, set
# DATABASE_URL to your provider's connection string. Requirements:
#   * driver prefix must be postgresql+asyncpg://
#   * SSL is mandatory — use ?ssl=require (asyncpg style, NOT ?sslmode=require)
#   * the backend auto-disables asyncpg's prepared-statement cache whenever the
#     URL contains ssl=, so pooled (PgBouncer) endpoints work out of the box
# Run migrations against the DIRECT (non-pooled) URL; the app can use either.
#
# Neon (pooled endpoint — note the "-pooler" host):
# DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DBNAME?ssl=require
# Neon (direct endpoint — use this for `alembic upgrade`):
# DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/DBNAME?ssl=require
#
# Supabase (pooled, transaction mode is port 6543):
# DATABASE_URL=postgresql+asyncpg://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?ssl=require
# Supabase (direct, port 5432 — use this for `alembic upgrade`):
# DATABASE_URL=postgresql+asyncpg://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?ssl=require

# ---- Frontend (React/Vite) ----
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:9000/api

# ---- Lab targets (lab/docker-compose.yml) ----
# Only used when the lab stack is started separately.
DVWA_PORT=8080
JUICE_SHOP_PORT=3000
TLS_TEST_PORT=8443
# Relative to lab/docker-compose.yml's own directory (Compose resolves bind-mount
# paths against the compose file's directory, not the shell's CWD).
JUICE_SHOP_DATA_DIR=../storage/lab/juice-shop

# --- OWASP ZAP ---
ZAP_API_URL=http://zap:8080
ZAP_API_KEY=vulnvista-dev-key

# --- NVD (used by the vulnerable_services detector for CVE lookups by CPE) ---
# Optional. Unset = 5 req/30s rate limit. Free key = 50 req/30s.
# Register at https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=
