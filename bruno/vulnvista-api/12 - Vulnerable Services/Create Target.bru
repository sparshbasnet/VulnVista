meta {
  name: Create Target
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/targets
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "name": "Metasploitable2 - Vulnerable Services",
    "target_type": "metasploitable2",
    "base_url": "http://metasploitable2",
    "environment": "lab",
    "authorization_confirmed": true
  }
}

script:post-response {
  if (res.body && res.body.id) {
    bru.setVar("vsTargetId", res.body.id);
  }
}

tests {
  test("target created and allowed", function() {
    expect(res.status).to.equal(201);
    expect(res.body.id).to.be.a("string");
    expect(res.body.is_allowed).to.equal(true);
  });
}

docs {
  Runs an nmap port scan/version fingerprint and matches services against known CVEs. Can take a couple of minutes.

  Run "Login" in the Auth folder first so {{accessToken}} is set. Bundled
  lab hosts (http://metasploitable2) are auto-approved (is_allowed=true) with no
  authorization_confirmed acknowledgment needed; it's sent here anyway so this
  same request works unmodified against any other host you point base_url at.
}
