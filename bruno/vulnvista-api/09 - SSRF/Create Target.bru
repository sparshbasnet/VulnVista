meta {
  name: Create Target
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/targets
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "name": "Juice Shop - SSRF",
    "target_type": "webapp",
    "base_url": "http://juice-shop:3000",
    "environment": "lab",
    "authorization_confirmed": true
  }
}

script:post-response {
  if (res.body && res.body.id) {
    bru.setVar("ssrfTargetId", res.body.id);
  }
}

tests {
  test("target created and allowed", function() {
    expect(res.status).to.equal(201);
    expect(res.body.id).to.be.a("string");
    expect(res.body.is_allowed).to.equal(true);
  });
}

docs {
  Confirms SSRF only via a callback to VulnVista's own listener from the Juice Shop image importer.

  Run "Login" in the Auth folder first so {{accessToken}} is set. Bundled
  lab hosts (http://juice-shop:3000) are auto-approved (is_allowed=true) with no
  authorization_confirmed acknowledgment needed; it's sent here anyway so this
  same request works unmodified against any other host you point base_url at.
}
