meta {
  name: Start Scan
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/scans
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "target_id": "{{cmdiTargetId}}",
    "scan_profile": "command_injection"
  }
}

script:post-response {
  if (res.body && res.body.id) {
    bru.setVar("cmdiScanId", res.body.id);
  }
}

tests {
  test("scan accepted", function() {
    expect(res.status).to.equal(201);
    expect(res.body.status).to.be.oneOf(["QUEUED", "RUNNING"]);
  });
}

docs {
  Run "Create Target" first so {{cmdiTargetId}} is set. Detectors
  run in the background — poll "Get Scan Status" until status is COMPLETED,
  PARTIAL, FAILED, or CANCELLED, then run "Get Findings".
}
