meta {
  name: Get Scan Status
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/scans/{{csrfScanId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

docs {
  Re-send this request until "status" is a terminal value (COMPLETED,
  PARTIAL, FAILED, CANCELLED), then run "Get Findings".
}
